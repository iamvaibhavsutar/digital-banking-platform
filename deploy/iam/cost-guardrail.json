{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "NoNatGatewaysOrEks", "Effect": "Deny",
      "Action": ["ec2:CreateNatGateway", "eks:CreateCluster", "elasticache:CreateCacheCluster", "redshift:CreateCluster"],
      "Resource": "*" },
    { "Sid": "OnlyCheapInstanceTypes", "Effect": "Deny",
      "Action": "ec2:RunInstances", "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": { "ForAnyValue:StringNotLike": { "ec2:InstanceType": ["t3.*", "t3a.*"] } } },
    { "Sid": "OnlySmallRds", "Effect": "Deny",
      "Action": ["rds:CreateDBInstance", "rds:ModifyDBInstance"], "Resource": "*",
      "Condition": { "ForAnyValue:StringNotLike": { "rds:DatabaseClass": ["db.t3.micro", "db.t4g.micro"] } } }
  ]
}
